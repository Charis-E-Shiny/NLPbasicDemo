{
  "name": "cadvoice",
  "private": true,
  "version": "1.0.0",
  "description": "CADVoice: local-first natural-language CAD and ECAD scene builder with a trained NLU model and real 3D models.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/nlp.test.js tests/js/*.test.mjs",
    "test:py": "python -m pytest -q tests/py",
    "train:model": "python ml/train.py",
    "test:e2e": "python tests/e2e/smoke.py http://localhost:4173/"
  },
  "dependencies": {
    "jspdf": "^3.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^7.1.2"
  }
}
